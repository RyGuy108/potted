# Copy to apps/web/.env.local and fill in. Never commit real keys.

# --- Ledger ---------------------------------------------------------------
# "sim" keeps balances in the local store so the UI runs with no chain.
# "solana" sends real devnet transactions through the escrow program.
POTTED_LEDGER=sim
SOLANA_RPC_URL=https://api.devnet.solana.com
POTTED_PROGRAM_ID=
# Devnet USDC mint (Circle faucet)
# Test USDC the faucet can mint. Create it with `pnpm --filter @potted/web solana:setup`;
# Circle's devnet USDC cannot be minted by the faucet.
USDC_MINT=
# Base58 secret key of the verifier signer. Only this key may settle.
VERIFIER_SECRET_KEY=

# --- Game data ------------------------------------------------------------
# Lichess needs no key. A token only raises rate limits.
LICHESS_TOKEN=
# Brawl Stars keys are bound to an IP address (developer.brawlstars.com).
BRAWLSTARS_API_KEY=
BRAWLSTARS_API_BASE=https://api.brawlstars.com/v1
# fortnite-api.com key (player must have public stats enabled)
FORTNITE_API_KEY=
# Steam Web API key (steamcommunity.com/dev/apikey). Covers any Steam game
# through achievement unlock times; the profile's game details must be public.
STEAM_API_KEY=

# --- Stream extras --------------------------------------------------------
# Voice announcer. Without a key the overlay falls back to the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Shared secret checked on the QuickNode Streams webhook
QUICKNODE_WEBHOOK_SECRET=

# --- Dev only -------------------------------------------------------------
# Lets the dashboard force a result for rehearsals. Receipts are marked
# "simulated". Keep this off for anything you show as real.
POTTED_ALLOW_SIMULATED_RESULTS=false

# --- Coordinator ----------------------------------------------------------
# Grok drafts challenge terms from fan ideas and writes the moderator's
# checklist. Without a key, fixed rules do both. It never settles anything.
XAI_API_KEY=
XAI_MODEL=grok-4.7

# --- Sign-in --------------------------------------------------------------
# A provider's button turns on when both of its keys are set. See docs/auth.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The Twitch keys also fetch each linked channel's profile picture and live
# preview for stream pages (app access token; streamers authorize nothing).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signs session cookies. Set a long random value when hosting.
SESSION_SECRET=
# The site's public address, for sign-in redirects and QR codes when hosted.
POTTED_PUBLIC_URL=

# --- Kick (the !potted bot in Kick chat) --------------------------------------
# From kick.com/settings/developer. Server-only: never NEXT_PUBLIC_. Register
# <POTTED_PUBLIC_URL>/api/connect/kick/callback and /api/webhooks/kick there.
# Steps: docs/kick.md. Streamers' own Kick tokens are stored per account,
# never here.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Optional: the key that seals stored tokens (32 bytes, base64). Without it a
# key is derived from SESSION_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
POTTED_TOKEN_KEY=

# Demo audience numbers on the browse page (people watching, streams live per
# game). They are made up; pots and pledges are always real. Set to off before
# showing the app as a real product.
POTTED_MOCK_ACTIVITY=on

# --- Email sign-in ----------------------------------------------------------
# Codes are mailed through Resend. With no key, a dev server shows the code
# on screen; a production server refuses unless POTTED_SHOW_EMAIL_CODES=true.
RESEND_API_KEY=
EMAIL_FROM=

# --- Privy wallets ------------------------------------------------------------
# With the Solana ledger on, real sign-ins get a wallet held by Privy, and
# Privy signs their transactions. Demo and test accounts stay custodial.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Supabase (off-chain data) -----------------------------------------------
# Profiles, challenges, pledges and clips in Postgres. Run
# supabase/migrations/*.sql first. Without these, a local JSON file is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
