# Copy to apps/web/.env.local and fill in. Never commit real keys.

# --- Ledger ---------------------------------------------------------------
# "sim" keeps balances in the local store so the UI runs with no chain.
# "solana" sends real devnet transactions through the escrow program.
POTTED_LEDGER=sim
SOLANA_RPC_URL=https://api.devnet.solana.com
POTTED_PROGRAM_ID=
# Devnet USDC mint (Circle faucet)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Base58 secret key of the verifier signer. Only this key may settle.
VERIFIER_SECRET_KEY=

# --- Game data ------------------------------------------------------------
# Lichess needs no key. A token only raises rate limits.
LICHESS_TOKEN=
# Brawl Stars keys are bound to an IP address (developer.brawlstars.com).
BRAWLSTARS_API_KEY=
BRAWLSTARS_API_BASE=https://api.brawlstars.com/v1
# fortnite-api.com key (player must have public stats enabled)
FORTNITE_API_KEY=

# --- Stream extras --------------------------------------------------------
# Voice announcer. Without a key the overlay falls back to the browser voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Shared secret checked on the QuickNode Streams webhook
QUICKNODE_WEBHOOK_SECRET=

# --- Dev only -------------------------------------------------------------
# Lets the dashboard force a result for rehearsals. Receipts are marked
# "simulated". Keep this off for anything you show as real.
POTTED_ALLOW_SIMULATED_RESULTS=false

# --- Coordinator ----------------------------------------------------------
# Grok drafts challenge terms from fan ideas and writes the moderator's
# checklist. Without a key, fixed rules do both. It never settles anything.
XAI_API_KEY=
XAI_MODEL=grok-4.7
