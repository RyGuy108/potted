{
  "name": "@potted/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "solana:setup": "node --env-file-if-exists=.env.local scripts/solana-setup.mjs",
    "test:solana": "SOLANA_TEST_RPC=http://127.0.0.1:8899 vitest run test/solana.integration.test.ts",
    "sample": "node --env-file-if-exists=.env.local --import tsx scripts/sample-data.ts",
    "quicknode": "node --env-file-if-exists=.env.local --import tsx scripts/quicknode.ts",
    "keys": "node --env-file-if-exists=.env.local --import tsx scripts/keys.ts",
    "badges:setup": "node --env-file-if-exists=.env.local --import tsx scripts/badges-setup.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@metaplex-foundation/mpl-bubblegum": "^6.0.0",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "^1.6.0",
    "@potted/chain": "workspace:*",
    "@potted/coordinator": "workspace:*",
    "@potted/core": "workspace:*",
    "@potted/verifier": "workspace:*",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-metadata": "0.1.6",
    "@solana/web3.js": "^1.99.0",
    "geist": "^1.9.2",
    "gsap": "^3.15.1",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
